# Copy this file to .env and fill the value locally.
# Generate a Lichess personal access token at:
# https://lichess.org/account/oauth/token
LICHESS_TOKEN=lip_***

# YouTube Data API v3 key for explanatory video search.
YOUTUBE_API_KEY=AIza***

# MongoDB connection URI. Environment-specific: local dev uses localhost,
# docker compose uses mongodb://mongodb:27017.
MONGODB_URI=mongodb://localhost:27017

# Milvus connection URI. Environment-specific: docker compose (standalone) uses
# http://localhost:19530 from the host; a local file path (e.g. ./.scratch/rag/milvus.db)
# uses Milvus Lite for dev and tests.
MILVUS_URI=http://localhost:19530

# Ollama base URL. Environment-specific: local dev uses localhost,
# docker compose uses http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434

# The active provider, model and base URL are selected in config.toml under [llm].
# Only the secret for the selected provider is needed here.
# NVIDIA NIM: NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY=nvapi-***
# Mistral: MISTRAL_API_KEY=...
MISTRAL_API_KEY=

# Optional TypeSafe/JEV intent router credentials. JEV is disabled by default in
# config.toml; set TYPESAFE_API_KEY only when explicitly enabling it.
TYPESAFE_API_KEY=apikey_

# Optional TypeSafe-compatible gateway URL. Defaults to https://api.typesafe.ai.
TYPESAFE_BASE_URL=https://api.typesafe.ai
